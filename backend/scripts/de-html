#!/usr/bin/env python3
"""Convert HTML fragments embedded in JSON strings to Markdown.

Usage:
    de-html filea.json [fileb.json ...]

By default sibling files are written as ``<name>.md.json``.  Pass
``--in-place`` to overwrite the input (a ``.bak`` copy is made on every run).

The converter walks every JSON value recursively and rewrites every string that
contains known HTML tags.  Strings without known tags are left byte-identical,
so ids, slugs, URLs, and tokens are safe.

Supported HTML:
    br i b u sup sub ex span table tr td th caption ul ol li p h1-h6 dl dt dd a hr

Deferred (left as raw HTML, reported in the summary):
    a, dl, dt, dd, h1-h6

The script is best-effort: malformed HTML is parsed tolerantly, and warnings are
printed.  Fixing the source data is still recommended.
"""

from __future__ import annotations

import argparse
import json
import os
import re
import shutil
import sys
from collections import Counter
from html.parser import HTMLParser
from typing import Any


# ---------------------------------------------------------------------------
# Tag sets
# ---------------------------------------------------------------------------

VOID_TAGS = {
    "area",
    "base",
    "br",
    "col",
    "embed",
    "hr",
    "img",
    "input",
    "link",
    "meta",
    "source",
    "track",
    "wbr",
}

DEFERRED_TAGS = {"a", "dl", "dt", "dd", "h1", "h2", "h3", "h4", "h5", "h6"}

BLOCK_TAGS = {
    "blockquote",
    "div",
    "dl",
    "ex",
    "h1",
    "h2",
    "h3",
    "h4",
    "h5",
    "h6",
    "hr",
    "ol",
    "p",
    "table",
    "ul",
}

KNOWN_TAGS = {
    "a",
    "b",
    "blockquote",
    "br",
    "caption",
    "dd",
    "div",
    "dl",
    "dt",
    "ex",
    "h1",
    "h2",
    "h3",
    "h4",
    "h5",
    "h6",
    "hr",
    "i",
    "img",
    "li",
    "ol",
    "p",
    "span",
    "sub",
    "sup",
    "table",
    "tbody",
    "td",
    "tfoot",
    "th",
    "thead",
    "tr",
    "u",
    "ul",
}

TAG_DETECT_RE = re.compile(
    r"</?(?:" + "|".join(sorted(KNOWN_TAGS)) + r")\b", re.IGNORECASE
)
SUSPICIOUS_RE = re.compile(r"<[a-zA-Z][a-zA-Z0-9]*<")
BAD_END_TAG_RE = re.compile(r"</[a-zA-Z][a-zA-Z0-9]*\s+[^>]*>")
TOKEN_RE = re.compile(r"\{\{[^{}]*\}\}")

PLACEHOLDER_PREFIX = "\uE000DEHTML"
PLACEHOLDER_SUFFIX = "\uE001"

